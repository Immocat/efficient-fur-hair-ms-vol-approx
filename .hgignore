# Build-related
^\.sconf_temp/.*$
^build/release/.*$
^build/debug/.*$
^debian/.*$
^.sconsign.dblite$
^config.py$
^config.log$
.*\.pyc$

# MSVC++-related
^build/mitsuba-msvc2010.sdf$
^build/mitsuba-msvc2010.suo$
